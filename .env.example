# GurudevBook Auto-Poster — Required Environment Variables
# Copy this file to .env for local testing (never commit .env to git)

# REQUIRED: Your Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Set to 1 on first deploy to send a smoke-test message to the channel
SMOKE_TEST_ON_BOOT=1

# Timezone for all scheduled posts
TZ=Asia/Kolkata

# Your Telegram channel handle
CHANNEL_USERNAME=@gurudevbook_official

# Registration CTA link
REGISTER_URL=https://gurudevbook.com/register

# Optional: override content/data directories (defaults work on Railway)
# CONTENT_DIR=/app/content
# DATA_DIR=/app/data
